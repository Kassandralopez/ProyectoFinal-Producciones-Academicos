package gestorDeProduccionesAcademicos;

public class Docente extends Usuario{
	String orientacion;
	String grado;
	String año;
	public String getOrientacion() {
		return orientacion;
	}
	public void setOrientacion(String orientacion) {
		this.orientacion = orientacion;
	}
	public String getGrado() {
		return grado;
	}
	public void setGrado(String grado) {
		this.grado = grado;
	}
	public String getAño() {
		return año;
	}
	public void setAño(String año) {
		this.año = año;
	}
	public Docente(String cedula, String nombre, String apellido, String contrasenia, String confirmaContra,
			String orientacion, String grado, String año) {
		super(cedula, nombre, apellido, contrasenia, confirmaContra);
		this.orientacion = orientacion;
		this.grado = grado;
		this.año = año;
	}
	

	
}
	
