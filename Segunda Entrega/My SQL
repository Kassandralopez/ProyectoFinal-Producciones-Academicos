	public void altaDocente(String cedula, String nombre, String apellido, String orientacion, String grado,
			String año) {
		String sentencia = "INSERT INTO Docentes(Cedula,Nombre,Apellido,Orientacion,Grado,Año) VALUES(" + cedula + ",'"
				+ nombre + "','" + apellido + "');" + orientacion + "');" + grado + "');" + año;
		System.out.println(sentencia);
		try {
			Connection conexion = getConnection();
			PreparedStatement declaracionSQL = conexion.prepareStatement(sentencia);
			declaracionSQL.executeUpdate();
			 declaracionSQL.setString(1, cedula);
		        declaracionSQL.setString(2, nombre);
		        declaracionSQL.setString(3, apellido);
		        declaracionSQL.setString(4, orientacion);
		        declaracionSQL.setString(5, grado);
		        declaracionSQL.setString(6, año);

		        int filas = declaracionSQL.executeUpdate();
		} catch (SQLException ex) {
			JOptionPane.showConfirmDialog(null, "Error" + ex.getMessage());
		}
	}

	public void listarDocente(DefaultTableModel modeloTablaDocente) {

		String sentencia = "Select cedula , nombre , apellido,orientacion,grado,año,rol FROM Docentes";
		try {
			Connection conexion = getConnection();
			PreparedStatement declaracionSQL = conexion.prepareStatement(sentencia);
			ResultSet rs = declaracionSQL.executeQuery();

			modeloTablaDocente.setRowCount(0);

			while (rs.next()) {
				String cedula = rs.getString(1);
				String nombre = rs.getString(2);
				String apellido = rs.getString(3);
				String orientacion = rs.getString(4);
				String grado = rs.getString(5);
				String año = rs.getString(6);
				

				Object[] fila = { cedula, nombre, apellido, orientacion, grado, año };
				modeloTablaDocente.addRow(fila);
			}
		} catch (SQLException ex) {
			JOptionPane.showConfirmDialog(null, "Error" + ex.getMessage());
		}
	}

	public void borrarDocente(String cedula) {
		String sentencia = "DELETE FROM Docentes WHERE cedula=?";

		System.out.println(sentencia);
		try {
			Connection conexion = getConnection();
			PreparedStatement declaracionSQL = conexion.prepareStatement(sentencia);

			int filasAfectadas = declaracionSQL.executeUpdate();

			if (filasAfectadas > 0) {
				JOptionPane.showMessageDialog(null, "Usuario eliminado ");
			} else {
				JOptionPane.showMessageDialog(null, "No se encontró ningun usuario con esa cedula");
			}

		} catch (SQLException ex) {
			JOptionPane.showMessageDialog(null, "Error al borrar: " + ex.getMessage(), "Error",
					JOptionPane.ERROR_MESSAGE);
		}
	}

