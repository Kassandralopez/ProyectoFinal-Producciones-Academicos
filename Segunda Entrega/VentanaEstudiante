public class VentanaEstudiante extends JFrame{
    private VentanaPrincipal pantallaAnterior;
    main gestor = new main();

	ArrayList<Estudiante> listarEstudiante = new ArrayList<>();

	public VentanaEstudiante (VentanaPrincipal anterior) {
