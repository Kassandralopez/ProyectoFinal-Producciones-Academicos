package gestorDeProduccionesAcademicos;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;


import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.ArrayList;
public class VentanaDocente extends JFrame{
	main gestor = new main();
	ArrayList<Docente> listaDocentes = new ArrayList<>();

    private VentanaPrincipal pantallaAnterior;
			public VentanaDocente (VentanaPrincipal anterior) {
				this.pantallaAnterior=anterior;

			this.setTitle("Docente");
			this.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
			this.setSize(750,500);
			this.setLocationRelativeTo(null);
			this.setResizable(false);
			this.setLayout(new BorderLayout(10, 10));
			
			JPanel panel1 = new JPanel ();
			panel1.setLayout(new  GridLayout(1, 8,5, 0));
			JPanel panel2= new JPanel();
			panel2.setLayout(new BorderLayout());
			JPanel panel3 = new JPanel();
			panel3.setLayout(new FlowLayout());
			
			String [] opcionesOrientacion = {"Agraria","Informatica","Carpinteria"};
			String [] opcionesAño= {"2026","2025","2024","2023"};
			String [] opcionesMateria = {"Matematica","Programacion","Tecnologia"};
			String [] opcionesGrados = {"1ero","2ndo","3ero","4rto","5to","6to"};
			
			JComboBox comboOrientacion = new JComboBox (opcionesOrientacion);
			JComboBox comboAño = new JComboBox (opcionesAño);
			JComboBox comboMateria= new JComboBox (opcionesMateria);
			JComboBox comboGrado = new JComboBox (opcionesGrados);
			
			JLabel espacioBlanco = new JLabel ("Docente");
			

			JButton atrasBoton = new JButton ("Atras");
			JButton actualizarBoton = new JButton ("Actualizar");
			JButton borrarBoton = new JButton ("Borrar");
			
			JLabel orientacionFiltro = new JLabel ("Orientacion");	
			JLabel gradoFiltro = new JLabel ("Grado");
			JLabel añoFiltro = new JLabel ("Año");
			JLabel materiaFiltro = new JLabel ("Materia");
						
			
			String[] columns = { "Cedula", "Nombre", "Apellido", "Orientacion", "Grado","Año" };
			DefaultTableModel modeloTablaDocente = new DefaultTableModel(columns,0) {
		            public boolean isCellEditable(int row, int column) {
		                return false; 
		            }
		        };
		       
			
			JTable tableDocentes = new JTable(modeloTablaDocente);
			JScrollPane scrollTablaDocentes = new JScrollPane(tableDocentes);
	        tableDocentes.setPreferredScrollableViewportSize(new Dimension(1200, 300));
			
			panel1.add(orientacionFiltro);
			panel1.add(comboOrientacion);
			
			panel1.add(añoFiltro);
			panel1.add(comboAño);
			
			panel1.add(materiaFiltro);
			panel1.add(comboMateria);
			
			panel1.add(gradoFiltro);
			panel1.add(comboGrado);

			panel2.add(scrollTablaDocentes);
		    
		    panel3.add(actualizarBoton);
		    panel3.add(borrarBoton);
		    panel3.add(atrasBoton);
		    
		    this.add(panel1, BorderLayout.NORTH);
			this.add(panel2, BorderLayout.CENTER);
			this.add(panel3,BorderLayout.SOUTH);
			

			atrasBoton.addActionListener(new ActionListener() {
				@Override
				public void actionPerformed(ActionEvent e) {
					
					if (pantallaAnterior != null) {
				 VentanaPrincipal ventanaPrincipal = new VentanaPrincipal();
					ventanaPrincipal.setVisible(true);      
					
			}
		            dispose();
		}

			
		});
		

	
			actualizarBoton.addActionListener(new ActionListener() {  

		@Override  
		public void actionPerformed(ActionEvent e) {  
			actualizarLista(modeloTablaDocente);  
			gestor.listarDocente(modeloTablaDocente);  
		}  

	});  
borrarBoton.addActionListener(new ActionListener() {  

	@Override  
	public void actionPerformed(ActionEvent e) {  
		int fila = tableDocentes.getSelectedRow();  
		if (fila == -1) {  
            JOptionPane.showMessageDialog(null, "Tiene que seleccionar a una persona");  
		}else {  
            String cedula = modeloTablaDocente.getValueAt(fila, 0).toString();  
            gestor.borrarDocente(cedula, cedula, cedula, cedula, cedula, cedula);  
            modeloTablaDocente.setRowCount(0);  
            gestor.listarDocente(modeloTablaDocente);  
		}  
	}  
});  
  
			}

  
  
public void actualizarLista(DefaultTableModel modelo) {  
	modelo.setRowCount(0);  
	for (Docente d : listaDocentes) {  
		Object[] fila = { d.getCedula(), d.getNombre(), d.getApellido() };  
		modelo.addRow(fila);  
	  
	}  

  



}

}




